@page "/"
@using Blazored.LocalStorage

<div class="container text-center mt-5" style="max-width: 450px; margin: auto; font-family: sans-serif;">

    <!-- 顶部导航 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <span class="text-secondary fw-bold">今日进度：@(currentIndex + 1) / @wordList.Count</span>
        <div>
            <a href="words" class="btn btn-outline-primary btn-sm me-2">📚 单词表</a>
            <button class="btn btn-sm btn-light" @onclick="ShuffleWords">🔄 重新随机</button>
        </div>
    </div>

    @if (isLoading)
    {
        <p class="text-muted">正在加载单词库...</p>
    }
    else if (wordList.Count == 0)
    {
        <p class="text-danger">找不到单词！请确保 words.txt 存在于 wwwroot 目录下。</p>
    }
    else
    {
        <!-- 单词卡片 -->
        <div class="card shadow-sm mb-4" style="border-radius: 15px; border: none;">
            <div class="card-body py-5">
                <h1 class="display-4 fw-bold text-dark">@currentWord.Spelling</h1>
                @if (showMeaning)
                {
                    <p class="fs-3 text-secondary mt-3">@currentWord.Meaning</p>
                }
            </div>
        </div>

        <!-- 底部按钮（发音按钮永久保留） -->
        <div class="d-flex justify-content-center gap-2">

            <!-- 发音按钮：始终存在 -->
            <button class="btn btn-secondary" style="width: 85px; height: 50px;" @onclick="SpeakWord">🔊 发音</button>

            @if (!showMeaning)
            {
                <!-- 未作答状态 -->
                <button class="btn btn-danger" style="width: 85px; height: 50px;" @onclick="DontKnowWord">不认识</button>
                <button class="btn btn-success" style="width: 85px; height: 50px;" @onclick="KnowWord">认识</button>
            }
            else
            {
                <!-- 已作答状态 -->
                @if (isKnownFlag)
                {
                    <!-- 只有点了“认识”才允许纠正 -->
                    <button class="btn btn-warning" style="width: 85px; height: 50px;" @onclick="MistakenWord">❌ 认错了</button>
                }
                <button class="btn btn-primary" style="width: 85px; height: 50px;" @onclick="NextWord">➡️ 下一个</button>
            }
        </div>
    }
</div>